# Required. Use a dedicated database; run Alembic before starting.
DATABASE_URL=sqlite:////absolute/path/outside/repository/estimoto-plus.sqlite
ENVIRONMENT=development
PHOTO_DIR=/absolute/path/outside/repository/estimoto-plus-photos

# Required for real customer sessions. Leave empty for isolated demo only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for live service requests and trusted inbound bridge routes.
BRIDGE_REQUEST_URL=
BRIDGE_KEY=

# Explicit local demo gate. Never enable in production.
DEV_SESSIONS_ENABLED=false
DEV_TOKEN_SECRET=
